{
  "$schema": "https://schema.management.azure.com/schemas/2019-08-01/managementGroupDeploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.43.8.12551",
      "templateHash": "7190463740418606807"
    }
  },
  "parameters": {
    "managingTenantId": {
      "type": "string",
      "minLength": 36,
      "maxLength": 36,
      "metadata": {
        "description": "Tenant ID of the managing tenant"
      }
    },
    "lighthouseOfferName": {
      "type": "string",
      "defaultValue": "Managed Cloud Operations",
      "metadata": {
        "description": "Display name for the Lighthouse offer"
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "denmarkeast",
      "metadata": {
        "description": "Default location used for resources or deployments requiring a location parameter"
      }
    },
    "version": {
      "type": "string",
      "defaultValue": "1.0.0",
      "metadata": {
        "description": "The version number of the lighthouse deployment template"
      }
    },
    "systemAgentPrincipalId": {
      "type": "string",
      "minLength": 36,
      "maxLength": 36,
      "metadata": {
        "description": "Object ID of the service principal that will be executing all actions through Azure lighthouse"
      }
    },
    "supportTeamPrincipalId": {
      "type": "string",
      "minLength": 36,
      "maxLength": 36,
      "metadata": {
        "description": "Object ID of the security group or service principal with permanent Reader access for support purposes"
      }
    },
    "specialistTeamPrincipalId": {
      "type": "string",
      "minLength": 36,
      "maxLength": 36,
      "metadata": {
        "description": "Object ID of the security group or service principal eligible for additional PIM-controlled access for support purposes"
      }
    },
    "policyDefinitionName": {
      "type": "string",
      "defaultValue": "MC-Deploy-Azure-Lighthouse",
      "metadata": {
        "description": "Policy definition name"
      }
    },
    "policyAssignmentName": {
      "type": "string",
      "defaultValue": "MC-Deploy-Azure-Lighthouse-MG",
      "metadata": {
        "description": "Policy assignment name"
      }
    }
  },
  "variables": {
    "roleIds": {
      "reader": "acdd72a7-3385-48ef-bd42-f606fba81ae7",
      "contributor": "b24988ac-6180-42a0-ab88-20f7382dd24c",
      "costManagementContributor": "434105ed-43f6-45c7-a02f-909b2ba83430",
      "resourcePolicyContributor": "36243c78-bf99-498c-9df9-86d9f8d28608",
      "userAccessAdministrator": "18d7d88d-d35e-4fb5-a5c3-7773c20a72d9"
    },
    "principalNames": {
      "supportTeam": "Managed Cloud Operations Support",
      "specialistTeam": "Managed Cloud Operations Specialist",
      "systemAgent": "Managed Cloud Operations Agent"
    },
    "authorizations": [
      {
        "principalId": "[parameters('systemAgentPrincipalId')]",
        "principalIdDisplayName": "[format('{0} (Contributor)', variables('principalNames').systemAgent)]",
        "roleDefinitionId": "[variables('roleIds').contributor]"
      },
      {
        "principalId": "[parameters('systemAgentPrincipalId')]",
        "principalIdDisplayName": "[format('{0} (Resource Policy Contributor)', variables('principalNames').systemAgent)]",
        "roleDefinitionId": "[variables('roleIds').resourcePolicyContributor]"
      },
      {
        "principalId": "[parameters('systemAgentPrincipalId')]",
        "principalIdDisplayName": "[format('{0} (Cost Management Contributor)', variables('principalNames').systemAgent)]",
        "roleDefinitionId": "[variables('roleIds').costManagementContributor]"
      },
      {
        "principalId": "[parameters('supportTeamPrincipalId')]",
        "principalIdDisplayName": "[format('{0} (Reader)', variables('principalNames').supportTeam)]",
        "roleDefinitionId": "[variables('roleIds').reader]"
      },
      {
        "principalId": "[parameters('specialistTeamPrincipalId')]",
        "principalIdDisplayName": "[format('{0} (Reader)', variables('principalNames').specialistTeam)]",
        "roleDefinitionId": "[variables('roleIds').reader]"
      }
    ],
    "eligibleAuthorizations": [
      {
        "principalId": "[parameters('specialistTeamPrincipalId')]",
        "principalIdDisplayName": "[format('{0} (Contributor)', variables('principalNames').specialistTeam)]",
        "roleDefinitionId": "[variables('roleIds').contributor]",
        "justInTimeAccessPolicy": {
          "multiFactorAuthProvider": "Azure",
          "maximumActivationDuration": "PT8H",
          "managedByTenantApprovers": []
        }
      },
      {
        "principalId": "[parameters('specialistTeamPrincipalId')]",
        "principalIdDisplayName": "[format('{0} (User Access Administrator)', variables('principalNames').specialistTeam)]",
        "roleDefinitionId": "[variables('roleIds').userAccessAdministrator]",
        "justInTimeAccessPolicy": {
          "multiFactorAuthProvider": "Azure",
          "maximumActivationDuration": "PT1H",
          "managedByTenantApprovers": []
        }
      }
    ],
    "commonMetadata": {
      "category": "Lighthouse",
      "version": "[parameters('version')]",
      "owner": "[variables('principalNames').systemAgent]",
      "createdBy": "Bicep",
      "deployment": "ManagementGroup"
    }
  },
  "resources": [
    {
      "type": "Microsoft.Authorization/policyDefinitions",
      "apiVersion": "2025-11-01",
      "name": "[parameters('policyDefinitionName')]",
      "properties": {
        "displayName": "Deploy Azure Lighthouse delegation",
        "policyType": "Custom",
        "mode": "All",
        "metadata": "[union(variables('commonMetadata'), createObject('description', 'Ensures all subscriptions are onboarded to Azure Lighthouse'))]",
        "parameters": {
          "managingTenantId": {
            "type": "String"
          },
          "lighthouseOfferName": {
            "type": "String"
          },
          "authorizations": {
            "type": "Array"
          },
          "eligibleAuthorizations": {
            "type": "Array"
          },
          "location": {
            "type": "String"
          }
        },
        "policyRule": {
          "if": {
            "field": "type",
            "equals": "Microsoft.Resources/subscriptions"
          },
          "then": {
            "effect": "deployIfNotExists",
            "details": {
              "type": "Microsoft.ManagedServices/registrationAssignments",
              "roleDefinitionIds": [
                "[format('/providers/Microsoft.Authorization/roleDefinitions/{0}', variables('roleIds').contributor)]",
                "[format('/providers/Microsoft.Authorization/roleDefinitions/{0}', variables('roleIds').userAccessAdministrator)]"
              ],
              "existenceCondition": {
                "allOf": [
                  {
                    "field": "Microsoft.ManagedServices/registrationAssignments/registrationDefinitionId",
                    "equals": "[[resourceId('Microsoft.ManagedServices/registrationDefinitions', guid(parameters('managingTenantId'), parameters('lighthouseOfferName')))]"
                  },
                  {
                    "field": "name",
                    "equals": "[[guid(subscription().subscriptionId, parameters('lighthouseOfferName'))]"
                  }
                ]
              },
              "deploymentScope": "subscription",
              "deployment": {
                "location": "[[parameters('location')]",
                "properties": {
                  "mode": "Incremental",
                  "template": {
                    "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
                    "contentVersion": "1.0.0.0",
                    "parameters": {
                      "managingTenantId": {
                        "type": "string"
                      },
                      "lighthouseOfferName": {
                        "type": "string"
                      },
                      "authorizations": {
                        "type": "array"
                      },
                      "eligibleAuthorizations": {
                        "type": "array"
                      }
                    },
                    "resources": [
                      {
                        "type": "Microsoft.ManagedServices/registrationDefinitions",
                        "apiVersion": "2022-10-01",
                        "name": "[[guid(parameters('managingTenantId'), parameters('lighthouseOfferName'))]",
                        "properties": {
                          "description": "Delegated Azure management via Azure Lighthouse",
                          "managedByTenantId": "[[parameters('managingTenantId')]",
                          "registrationDefinitionName": "[[parameters('lighthouseOfferName')]",
                          "authorizations": "[[parameters('authorizations')]",
                          "eligibleAuthorizations": "[[parameters('eligibleAuthorizations')]"
                        }
                      },
                      {
                        "type": "Microsoft.ManagedServices/registrationAssignments",
                        "apiVersion": "2022-10-01",
                        "name": "[[guid(subscription().subscriptionId, parameters('lighthouseOfferName'))]",
                        "properties": {
                          "registrationDefinitionId": "[[resourceId('Microsoft.ManagedServices/registrationDefinitions', guid(parameters('managingTenantId'), parameters('lighthouseOfferName')))]"
                        }
                      }
                    ]
                  },
                  "parameters": {
                    "managingTenantId": {
                      "value": "[parameters('managingTenantId')]"
                    },
                    "lighthouseOfferName": {
                      "value": "[parameters('lighthouseOfferName')]"
                    },
                    "authorizations": {
                      "value": "[variables('authorizations')]"
                    },
                    "eligibleAuthorizations": {
                      "value": "[variables('eligibleAuthorizations')]"
                    },
                    "location": {
                      "value": "[parameters('location')]"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "type": "Microsoft.Authorization/policyAssignments",
      "apiVersion": "2025-11-01",
      "name": "[parameters('policyAssignmentName')]",
      "location": "[parameters('location')]",
      "identity": {
        "type": "SystemAssigned"
      },
      "properties": {
        "displayName": "Deploy Azure Lighthouse to all subscriptions",
        "description": "Automatically deploys Azure Lighthouse delegation to all subscriptions under this management group.",
        "policyDefinitionId": "[extensionResourceId(managementGroup().id, 'Microsoft.Authorization/policyDefinitions', parameters('policyDefinitionName'))]",
        "enforcementMode": "Default",
        "metadata": "[union(variables('commonMetadata'), createObject('description', 'Automatically deploys Azure Lighthouse delegation to all subscriptions under this management group'))]",
        "parameters": {
          "managingTenantId": {
            "value": "[parameters('managingTenantId')]"
          },
          "lighthouseOfferName": {
            "value": "[parameters('lighthouseOfferName')]"
          },
          "authorizations": {
            "value": "[variables('authorizations')]"
          },
          "eligibleAuthorizations": {
            "value": "[variables('eligibleAuthorizations')]"
          },
          "location": {
            "value": "[parameters('location')]"
          }
        }
      },
      "dependsOn": [
        "[extensionResourceId(managementGroup().id, 'Microsoft.Authorization/policyDefinitions', parameters('policyDefinitionName'))]"
      ]
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "name": "[guid(managementGroup().id, extensionResourceId(managementGroup().id, 'Microsoft.Authorization/policyAssignments', parameters('policyAssignmentName')), variables('roleIds').contributor)]",
      "properties": {
        "roleDefinitionId": "[format('{0}/providers/Microsoft.Authorization/roleDefinitions/{1}', managementGroup().id, variables('roleIds').contributor)]",
        "principalId": "[reference(extensionResourceId(managementGroup().id, 'Microsoft.Authorization/policyAssignments', parameters('policyAssignmentName')), '2025-11-01', 'full').identity.principalId]",
        "principalType": "ServicePrincipal"
      },
      "dependsOn": [
        "[extensionResourceId(managementGroup().id, 'Microsoft.Authorization/policyAssignments', parameters('policyAssignmentName'))]"
      ]
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "name": "[guid(managementGroup().id, extensionResourceId(managementGroup().id, 'Microsoft.Authorization/policyAssignments', parameters('policyAssignmentName')), variables('roleIds').userAccessAdministrator)]",
      "properties": {
        "roleDefinitionId": "[format('{0}/providers/Microsoft.Authorization/roleDefinitions/{1}', managementGroup().id, variables('roleIds').userAccessAdministrator)]",
        "principalId": "[reference(extensionResourceId(managementGroup().id, 'Microsoft.Authorization/policyAssignments', parameters('policyAssignmentName')), '2025-11-01', 'full').identity.principalId]",
        "principalType": "ServicePrincipal"
      },
      "dependsOn": [
        "[extensionResourceId(managementGroup().id, 'Microsoft.Authorization/policyAssignments', parameters('policyAssignmentName'))]"
      ]
    }
  ]
}